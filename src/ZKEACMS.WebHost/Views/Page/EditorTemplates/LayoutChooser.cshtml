@model String
@{
    var page = ViewBag.Page as PageEntity;
    var descriptor = ViewData.ModelMetadata.GetViewDescriptor();
    IList<LayoutEntity> layouts = layouts = layoutService.GetWithFull();
    LayoutEntity customPageLayout = null;
    
    if (page.ID.IsNotNullAndWhiteSpace() && (zoneService.GetByPageId(page.ID).Any() || layoutHtmlService.GetByPageId(page.ID).Any()))
    {
        customPageLayout = layoutService.GetByPage(page);
    }
}

@inject ILayoutService layoutService
@inject IZoneService zoneService
@inject ILayoutHtmlService layoutHtmlService

<div class="input-group clearfix">
    @Html.Hidden("", Model, descriptor?.ToHtmlProperties())
    @foreach (var layoutItem in layouts)
    {
        var layout = customPageLayout?.ID == layoutItem.ID ? customPageLayout : layoutItem;
        <div class="layout-item pull-left @(layout.ID == Model ? "active" : "")" data-id="@layout.ID">
            @if (layout.LayoutName.IsNotNullAndWhiteSpace())
            {
                <label class="name">
                    @layout.LayoutName
                </label>
            }
            @for (int i = 0; i < layout.Html.Count; i++)
            {
                var item = layout.Html[i];
                @Html.Raw(item.Html)
                if (item.Html == ZoneEntity.ZoneTag)
                {
                    i++;
                    var headingCode = layout.Html[i].Html;
                    var zone = layout.Zones.FirstOrDefault(m => m.HeadingCode == headingCode);
                    if (zone != null)
                    {
                        <span class="zone-name">@zone.ZoneName</span>
                    }
                }
            }
            @if (layout == customPageLayout)
            {
                <a class="reset-layout name" href="@Url.Action("ResetLayout", new { pageId = page.ID })">@L("Reset")</a>
            }
        </div>
    }
</div>

@using (Script.AtFoot())
{
    <script type="text/javascript">
        $(function () {
            $(document).on("click", ".layout-item", function () {
                $("#LayoutId").val($(this).data("id"));
                $(this).siblings().removeClass("active");
                $(this).addClass("active");
            }).on("click",".reset-layout",function(){
                return confirm("@L("ResetLayoutConfirm")");
            });
            if (!$("#LayoutId").val()) {
                $(".layout-item:first").click();
            }
        });
    </script>
}
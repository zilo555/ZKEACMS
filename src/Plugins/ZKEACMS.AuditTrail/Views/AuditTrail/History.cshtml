@using Easy.Serializer
@using ZKEACMS
@model List<Easy.AuditTrail.AuditTrailRecord>
@{
    Layout = Layouts.PopUp;
    this.WorkContext().CurrentPage.Title = L("Change History").Text;
}
@using (Style.AtHead())
{
    <style>
        html body {
            background: #fff;
        }

        body .pagination {
            margin: 10px 0 0;
        }

        .diff-added {
            background-color: #d4edda;
            color: #155724;
            padding: 1px 2px;
            border-radius: 2px;
        }

        .diff-removed {
            background-color: #f8d7da;
            color: #721c24;
            padding: 1px 2px;
            border-radius: 2px;
        }

        .text-ellipsis {
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
            white-space: nowrap;
        }

        tr {
            cursor: pointer;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #fff;
            display: none;
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

            .modal-overlay.active {
                opacity: 1;
            }

        .modal-head {
            margin-bottom: 5px;
        }

        .modal-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            padding: 10px;
        }

        .two-columns {
            display: flex;
            flex: 1;
            overflow: hidden;
            gap: 10px;
        }

        .column {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
            background-color: #f5f5f5;
            border-radius: 12px;
            border: 1px solid #ccc;
        }
    </style>
}
<div style="background:#fff">
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover" style="margin:0; table-layout: fixed;">
            <thead>
                <tr>
                    <th>@L("ContentType@Fields")</th>
                    <th>@L("Old Value")</th>
                    <th>@L("New Value")</th>
                    <th style="width: 140px;">@L("LastUpdateByName")</th>
                    <th style="width: 155px;">@L("Last-Modified")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model)
                {
                    var changes = JsonConverter.Deserialize<Easy.AuditTrail.FieldChange[]>(record.Changes ?? "[]");
                    for (int i = 0; i < changes.Length; i++)
                    {
                        var change = changes[i];
                        <tr>
                            <td>@change.Field</td>
                            <td>
                                @if (change.ChangeType == (int)Easy.AuditTrail.AuditChangeType.Deleted)
                                {
                                    <div class="text-ellipsis">
                                        <span class="label label-danger">@L("Delete")</span>
                                        <del class="text-danger old-value-cell">@change.OldValue</del>
                                    </div>
                                }
                                else
                                {
                                    <div class="old-value-cell text-muted text-ellipsis">@change.OldValue</div>
                                }                                
                            </td>
                            <td>
                                @if (change.ChangeType == (int)Easy.AuditTrail.AuditChangeType.Added)
                                {
                                    <div class="text-ellipsis">
                                        <code class="label label-success">@L("Add")</code>
                                        <span class="text-success new-value-cell">@change.NewValue</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="new-value-cell text-success text-ellipsis">@change.NewValue</div>
                                }
                            </td>
                            @if (i == 0)
                            {
                                <td rowspan="@changes.Length">@record.CreatebyName</td>
                                <td rowspan="@changes.Length">@record.CreateDate.Value.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count > 0 && ViewBag.Pagin != null)
    {
        await Html.Pagin((ZKEACMS.Pagin)ViewBag.Pagin);
    }
</div>
<div id="modalOverlay" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-head">
            <code class="small">ESC</code>
            <button id="closeModalBtn" type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="two-columns">
            <div id="leftColumn" class="column"></div>
            <div id="rightColumn" class="column"></div>
        </div>
    </div>
</div>
@using (Script.AtFoot())
{
    <script type="text/javascript">
        $(function () {
            function diffText(oldText, newText) {
                const oldTokens = tokenizeText(oldText);
                const newTokens = tokenizeText(newText);

                const m = oldTokens.length;
                const n = newTokens.length;

                const dp = Array(m + 1).fill().map(() => Array(n + 1).fill(0));

                for (let i = 1; i <= m; i++) {
                    for (let j = 1; j <= n; j++) {
                        if (oldTokens[i - 1] === newTokens[j - 1]) {
                            dp[i][j] = dp[i - 1][j - 1] + 1;
                        } else {
                            dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
                        }
                    }
                }

                let i = m, j = n;
                const oldResult = [];
                const newResult = [];

                while (i > 0 || j > 0) {
                    if (i > 0 && j > 0 && oldTokens[i - 1] === newTokens[j - 1]) {
                        oldResult.unshift({ text: oldTokens[i - 1], type: 'same' });
                        newResult.unshift({ text: newTokens[j - 1], type: 'same' });
                        i--;
                        j--;
                    } else if (j > 0 && (i === 0 || dp[i][j - 1] >= dp[i - 1][j])) {
                        newResult.unshift({ text: newTokens[j - 1], type: 'added' });
                        j--;
                    } else if (i > 0 && (j === 0 || dp[i][j - 1] < dp[i - 1][j])) {
                        oldResult.unshift({ text: oldTokens[i - 1], type: 'removed' });
                        i--;
                    }
                }

                return {
                    oldResult: mergeAdjacentTokens(oldResult),
                    newResult: mergeAdjacentTokens(newResult)
                };
            }

            function tokenizeText(text) {
                const tokenRegex = /(\s+|[^\w\s]|\w+)/g;
                const tokens = [];
                let match;

                while ((match = tokenRegex.exec(text)) !== null) {
                    tokens.push(match[0]);
                }

                return tokens;
            }

            function mergeAdjacentTokens(tokens) {
                if (tokens.length === 0) return [];

                const result = [];
                let currentToken = { ...tokens[0] };

                for (let i = 1; i < tokens.length; i++) {
                    if (tokens[i].type === currentToken.type) {
                        currentToken.text += tokens[i].text;
                    } else {
                        result.push(currentToken);
                        currentToken = { ...tokens[i] };
                    }
                }

                result.push(currentToken);
                return result;
            }

            function tokensToHtml(tokens) {
                return tokens.map(token => {
                    let className = '';
                    switch (token.type) {
                        case 'added':
                            return `<span class="diff-added">${token.text}</span>`;
                        case 'removed':
                            return `<del class="diff-removed">${token.text}</del>`;
                        case 'same':
                            return `<span>${token.text}</span>`;
                        default:
                            return `<span>${token.text}</span>`;
                    }
                }).join('');
            }

            const openModalBtn = document.getElementById('openModalBtn');
            const closeModalBtn = document.getElementById('closeModalBtn');
            const modalOverlay = document.getElementById('modalOverlay');
            const leftColumn = document.getElementById('leftColumn');
            const rightColumn = document.getElementById('rightColumn');
            let isSyncingScroll = false;

            const openModal = () => {
                modalOverlay.style.display = 'block';

                requestAnimationFrame(() => {
                    modalOverlay.classList.add('active');
                });
                leftColumn.scrollTop = 0;
                rightColumn.scrollTop = 0;
            };

            const closeModal = () => {
                modalOverlay.classList.remove('active');
                setTimeout(() => {
                    modalOverlay.style.display = 'none';
                }, 300);
            };

            closeModalBtn.addEventListener('click', closeModal);
            modalOverlay.addEventListener('click', (e) => {
                if (e.target === modalOverlay) {
                    closeModal();
                }
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && modalOverlay.style.display === 'block') {
                    closeModal();
                }
            });
            const syncScroll = (source, target) => {
                if (isSyncingScroll) return;
                isSyncingScroll = true;
                const scrollRatio = source.scrollTop / (source.scrollHeight - source.clientHeight);
                target.scrollTop = scrollRatio * (target.scrollHeight - target.clientHeight);
                setTimeout(() => {
                    isSyncingScroll = false;
                }, 10);
            };

            leftColumn.addEventListener('scroll', () => {
                syncScroll(leftColumn, rightColumn);
            });

            rightColumn.addEventListener('scroll', () => {
                syncScroll(rightColumn, leftColumn);
            });

            $('tr').click(function () {
                const oldValueCell = $(this).find('.old-value-cell');
                const newValueCell = $(this).find('.new-value-cell');

                const oldText = $.trim(oldValueCell.html());
                const newText = $.trim(newValueCell.html());
                if (oldText || newText) {
                    openModal();
                    const diffResult = diffText(oldText, newText);
                    leftColumn.innerHTML = tokensToHtml(diffResult.oldResult);
                    rightColumn.innerHTML = tokensToHtml(diffResult.newResult);
                }
            });

        });
    </script>
}